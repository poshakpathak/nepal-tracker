 ],
 "listed": true,
 "bio": {
  "Political Biography": "विगत ४ वर्ष देखि राष्ट्रिय स्वतन्त्र पार्टीमा आबद्ध भई काम गरि रहेको । २०७९ सालको चुनावमा यसै पार्टीबाट समानुपातिक उम्मेदवार थिए । पछि पार्टीको केन्द्रीय सदस्यको रुपमा पार्टीमा आफ्नो भूमिका निर्वाह गरिरहेको छु । २०८२ सालको चुनावमा फेरी पार्टीको तर्फबाट समानुपातिक सांसदको रुपमा निर्वाचित भएको ।",
  "Previous Experience": "विगत १६ वर्षदेखि नर्सिङ पेशामा आवद्ध रहेको,\nB.P. Koirala Institute of Health Science मा Sr. Staff Nurse को रुपमा ३ वर्ष सम्म काम गरेको ।\nआफ्नो  Master Degree  पछि विभिन्न Nursing College हरुमा  As a Lecturer को रुपमा काम गरेको साथै विभन्न Research गर्नुको साथै Student Research  मा guide गरेको ।",
  "Current Affiliation": "हाल नेपाल प्रहरी श्रीमती संघ कोशी प्रदेशको प्रशासन सचिवको रुपमा कार्यरत रहेको र आसरा सुधार केन्द्रको सदस्य रहेको ।",
  "Publications": "Clinical Manval of Nursing Procedure ( for BSC Nursing)"
 },
