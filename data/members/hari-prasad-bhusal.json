 "listed": true,
 "bio": {
  "Political Biography": "२०७३ सालबाट विवेकशील साझा पार्टी मार्फत वैकल्पिक राजनीतिमा सक्रिय बनेको म रास्वपा स्थापना पछि शुरुबाटै सक्रिय छु । २०७९ को निर्वाचनमा रास्वपाबाट उम्मेदवार बनी तेस्रो वनेको र यो निर्वाचनबाट निर्वाचित भएको हुँ ।",
  "Previous Experience": "लायन्स क्लब र अर्घाखाँची चेम्बर अफ कमर्स मार्फत सामाजिक गतिविधिमा सक्रिय रहेको ।",
  "Current Affiliation": "–लायन्स क्लव र अर्घाखाँची चेम्बरमा आवद्ध छु ।\n–अर्घाखाँचीमा आर्ट व्यवसाय र मिडिया संचालक छु ।"
 },
