 "listed": true,
 "bio": {
  "Political Biography": "२०४७ फागुनमा  नेकपा एमालेको जनसंगठन अनेरास्ववियूमा संगठित भई राजनीति प्रारम्भ । २०५१ पुष देखि उत्पीडित दलित आन्दोलनको संगठन मुक्ति समाज नेपालमा संगठित। हाल मुक्ति समाज नेपालको केन्द्रीय उपमहासचिव र नेकपा एमाले कोशी प्रदेश कमिटीको सचिवालय सदस्यमा कार्यरत ।",
  "Previous Experience": "पत्रकारिता, प्रिन्टिङ प्रेस पेशाको रुपमा गरेको । गैर सरकारी संस्था महासंघ झापाको सचिव भई भूमिका निर्वाह गरी सकेको । जिल्ला समन्वय समिति झापाको (२०७४–७९) प्रमुख भई काम गरेको । २०६५ पौष देखि ०६६ असार सम्म दलिग वर्ग उत्थान जिल्ला समन्वय समितिको उपाध्यक्ष भई काम गरेको ।",
  "Current Affiliation": "उत्पीडित अधिकार मञ्च नेपाल नामक सामाजिक संस्थाको अध्यक्ष  र श्रद्धा गहना गृह विर्तामोडको प्रोपाइटर ।",
  "Publications": "पत्रपत्रिका र अनलाइन मिडियाहरुमा फुटकर लेख रचनाहरु प्रकाशन ।",
  "Awards and Honors": "मुक्ति समाज नेपाल कोशीले स्थापना गरेको नवराज शंकर युवा प्रोत्साहन पुरस्कार २०८० प्राप्त ।"
 },
