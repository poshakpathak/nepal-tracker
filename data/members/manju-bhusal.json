 "listed": true,
 "bio": {
  "Political Biography": "म सानै देखि आफ्नी हजुरआमाबाट निकै प्रेरित भई समाजसेवामा संलग्न हुँदै आएको हुँ। विद्यालय जीवनदेखि सामाजिक कार्यमा सक्रिय रहँदै आएको अनुभवले मलाई राजनीतितर्फ अघि बढ्न प्रेरित गर्‍यो। हाल म जनताको सेवा समावेशी विकास र सकारात्मक परिवर्तनका लागि प्रतिबद्ध छु।",
  "Previous Experience": "विगतमा पेशा धेरै थिए जस मध्ये केही लुम्बिनी निर्माण व्यवसायी संघ अध्यक्ष, नेपाल घरेलु तथा साना उद्योग महासंघ सल्लाहकार, पश्चिम नेपाल यातायात सल्लाहकार, बुटवल महिला डो. सी डा. २०१६ अध्यक्ष तथा नेपाल डो.सी.डा. २०१७ को राष्ट्रिय महिला संयोजक आदि। निर्माण व्यवसायी, समाजसेवी, विभिन्न अनुभव मार्फत नेतृत्व क्षमता, समन्वय र जनसमस्याको समाधानमा व्यावहारिक सिप।",
  "Current Affiliation": "-निर्माण व्यवसायी\n-नेपाल डो.सी.डा.चेम्बर कमर्सको प्रदेश सदस्य उद्योग संघको पूर्व का. सदस्य\n-लुम्बिनी निर्माण व्यवसायी संघ भु. अध्यक्ष निवर्तमान\n-बुटवल उद्योग बाणिज्य संघ कार्यसमिति सदस्य यातायात व्यवसायी सल्लाहकार।",
  "Publications": "विशेष पुस्तक वा लेख प्रकाशित नभए पनि सामाजिक राजनीतिक र जनसरोकारका विषयमा विभिन्न कार्यक्रम, अन्तरक्रिया र मन्चहरुमा आफ्नो विचार प्रस्तुत गर्दै सकृय सहभागिता जनाउँदै आएकी छु।",
  "Awards and Honors": "सामाजिक सेवा, महिला सशक्तिकरण र समुदाय विकासमा सकृय योगदानका लागि विभिन्न स्थानीय तथा सामाजिक संघ संस्थाबाट सम्मानित।"
 },
